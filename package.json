{
  "name": "streamdeck-gemini-tracker",
  "version": "1.0.0",
  "description": "Elgato Stream Deck plugin to track Google Antigravity AI quotas: Weekly, 5-Hour rolling, Claude & GPT, and Gemini 4 Argon limits.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.mjwitz.gemini-tracker\"",
    "validate": "streamdeck validate com.mjwitz.gemini-tracker.sdPlugin",
    "pack": "streamdeck pack com.mjwitz.gemini-tracker.sdPlugin --output dist --force",
    "test": "tsx test/plugin.test.ts",
    "diagnose": "tsx scripts/diagnose.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mjwitz/StreamDeckGeminiTracker.git"
  },
  "keywords": [
    "streamdeck",
    "streamdeck-plugin",
    "antigravity",
    "gemini",
    "gemini-4-argon",
    "claude",
    "gpt",
    "rate-limit",
    "quota-tracker",
    "elgato"
  ],
  "author": "Mjwitz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Mjwitz/StreamDeckGeminiTracker/issues"
  },
  "homepage": "https://github.com/Mjwitz/StreamDeckGeminiTracker#readme",
  "dependencies": {
    "@elgato/streamdeck": "^3.0.4"
  },
  "devDependencies": {
    "@elgato/cli": "^1.2.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "~24.1.0",
    "rollup": "^4.0.2",
    "tslib": "^2.6.2",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3"
  }
}
